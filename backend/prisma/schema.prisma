// backend/prisma/schema.prisma
// Safety Forms Analyzer - Complete Schema
// Updated: November 2025

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MAIN FORMS TABLE
// ============================================================================

model ProcessedForm {
  id                      String   @id @default(cuid())
  processingId           String   @unique
  originalFileName       String
  formType               FormType @default(TAKE5)
  workerName             String?
  site                   String?
  extractedText          String   @db.Text
  aiAnalysis             Json
  riskScore              Int
  requiresSupervisorReview Boolean @default(false)
  status                 FormStatus @default(PENDING_REVIEW)
  reviewedBy             String?
  reviewedAt             DateTime?
  reviewNotes            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  metadata               Json?
  
  // Relations
  issues                 SafetyIssue[]
  complianceChecks       ComplianceCheck[]
  
  @@map("processed_forms")
  @@index([status, createdAt])
  @@index([riskScore, createdAt])
  @@index([site, formType])
  @@index([formType])
}

// ============================================================================
// SAFETY ISSUES
// ============================================================================

model SafetyIssue {
  id          String      @id @default(cuid())
  formId      String
  category    IssueCategory
  description String
  severity    Severity
  recommendation String?
  resolved    Boolean     @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime    @default(now())
  
  form        ProcessedForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  
  @@map("safety_issues")
  @@index([category, severity])
  @@index([formId])
}

// ============================================================================
// COMPLIANCE CHECKS
// ============================================================================

model ComplianceCheck {
  id          String      @id @default(cuid())
  formId      String
  standard    String
  issue       String?
  action      String?
  compliant   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  
  form        ProcessedForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  
  @@map("compliance_checks")
  @@index([formId])
}

// ============================================================================
// PROCESSING LOGS
// ============================================================================

model ProcessingLog {
  id            String      @id @default(cuid())
  processingId  String
  status        ProcessingStatus
  errorMessage  String?
  processingTime Int?        // milliseconds
  aiProvider    String?
  metadata      Json?
  createdAt     DateTime    @default(now())
  
  @@map("processing_logs")
  @@index([status, createdAt])
  @@index([processingId])
}

// ============================================================================
// USERS
// ============================================================================

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  name        String
  role        UserRole    @default(WORKER)
  site        String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@map("users")
}

// ============================================================================
// SYSTEM CONFIGURATION
// ============================================================================

model SystemConfig {
  id          String      @id @default(cuid())
  key         String      @unique
  value       Json
  description String?
  updatedAt   DateTime    @updatedAt
  
  @@map("system_config")
}

// ============================================================================
// ENUMS
// ============================================================================

// Form Types - 32 different safety form categories
enum FormType {
  // Pre-Work Planning (6)
  TAKE5                      // Take 5 safety check
  PRE_TASK_BRIEF            // Pre-task safety briefing
  JSEA                      // Job Safety Environmental Analysis
  JSA                       // Job Safety Analysis
  JHA                       // Job Hazard Analysis
  SWMS                      // Safe Work Method Statement
  
  // Assessments (3)
  HAZARD_ASSESSMENT         // General hazard assessment
  RISK_ASSESSMENT           // Detailed risk assessment
  SITE_ASSESSMENT           // Site safety assessment
  
  // Inspections (4)
  INSPECTION_REPORT         // General inspection
  EQUIPMENT_INSPECTION      // Equipment/tools inspection
  VEHICLE_CHECKLIST         // Vehicle pre-start check
  WORKPLACE_INSPECTION      // Workplace safety inspection
  
  // Permits (5)
  PERMIT_TO_WORK           // General work permit
  HOT_WORK_PERMIT          // Hot work/welding permit
  CONFINED_SPACE_ENTRY     // Confined space permit
  HEIGHT_WORK_PERMIT       // Working at height permit
  EXCAVATION_PERMIT        // Excavation work permit
  
  // Training & Induction (4)
  TOOLBOX_TALK             // Toolbox/safety meeting
  SITE_INDUCTION           // Site induction form
  TRAINING_RECORD          // Training attendance/completion
  COMPETENCY_ASSESSMENT    // Skills/competency check
  
  // Incidents & Reporting (4)
  INCIDENT_REPORT          // Incident/accident report
  NEAR_MISS               // Near miss report
  HAZARD_REPORT           // Hazard identification report
  INJURY_REPORT           // Injury/first aid report
  
  // Other (4)
  EMERGENCY_DRILL         // Emergency evacuation drill
  SAFE_OPERATING_PROCEDURE // SOP documentation
  ENVIRONMENTAL_CHECK     // Environmental monitoring
  OTHER                   // Other/unclassified
}

// Form Processing Status
enum FormStatus {
  PENDING_REVIEW    // Awaiting supervisor review
  APPROVED          // Approved by supervisor
  REJECTED          // Rejected - needs correction
  ARCHIVED          // Archived/completed
}

// Safety Issue Categories
enum IssueCategory {
  PPE               // Personal Protective Equipment
  HAZARD            // General hazard
  PROCEDURE         // Procedure/process issue
  DOCUMENTATION     // Documentation incomplete/incorrect
  ENVIRONMENTAL     // Environmental concern
  EQUIPMENT         // Equipment/tool issue
  TRAINING          // Training/competency gap
  OTHER             // Other issue
}

// Issue Severity Levels
enum Severity {
  LOW               // Low risk - minor issue
  MEDIUM            // Medium risk - needs attention
  HIGH              // High risk - urgent action required
  CRITICAL          // Critical risk - stop work
}

// Processing Status
enum ProcessingStatus {
  PROCESSING        // Currently processing
  COMPLETED         // Successfully completed
  FAILED            // Processing failed
  RETRYING          // Retrying after failure
}

// User Roles
enum UserRole {
  WORKER            // Standard worker
  SUPERVISOR        // Supervisor - can review/approve
  ADMIN             // Administrator - full access
  SUPER_ADMIN       // Super admin - system config
}
